{
  "name": "@hexlet/code",
  "version": "1.0.0",
  "description": "Генератор HTML-форм на TypeScript",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint && oxfmt --check",
    "format": "oxfmt",
    "test": "vitest run",
    "test-coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicky2pc/react-urfu-project-81.git"
  },
  "bugs": {
    "url": "https://github.com/nicky2pc/react-urfu-project-81/issues"
  },
  "homepage": "https://github.com/nicky2pc/react-urfu-project-81#readme",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
